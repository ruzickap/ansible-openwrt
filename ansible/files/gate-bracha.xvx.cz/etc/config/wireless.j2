
config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc/a000000.wifi'
	option band '2g'
	option channel '{{ wifi_channel_2ghz }}'
	option htmode 'HT20'
	option country 'CZ'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid '{{ wifi_ssid }} 2.4 GHz'
	option encryption 'sae-mixed'
	option key '{{ wifi_password }}'

config wifi-iface 'kerova11_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid '{{ wifi_ssid }}'
	option encryption 'sae-mixed'
	option key '{{ wifi_password }}'
	option ieee80211r '1'
	option mobility_domain '4b31'
	option ft_over_ds '0'
	option ieee80211k '1'
	option bss_transition '1'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'platform/soc/a800000.wifi'
	option band '5g'
	option channel '{{ wifi_channel_5ghz }}'
	option htmode 'VHT80'
	option country 'CZ'

config wifi-iface 'kerova11_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid '{{ wifi_ssid }}'
	option encryption 'sae-mixed'
	option key '{{ wifi_password }}'
	option ieee80211r '1'
	option mobility_domain '4b31'
	option ft_over_ds '0'
	option ieee80211k '1'
	option bss_transition '1'
